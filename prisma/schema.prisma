  fullName       String
  email          String
  phone          String
  college        String
  graduationYear Int
  sourceSlug     String?
  createdAt      DateTime @default(now())

  team HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

