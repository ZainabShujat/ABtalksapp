# Chatbot
ENABLE_CHATBOT=true

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth / application secret
AUTH_SECRET=your_auth_secret_here

# ------------------------------------------------------------ voice interview
# One key covers all three legs: speech-to-text, text-to-speech, and the model
# that reads the answers. Without it the interview falls back to the mock judge,
# which scores every candidate the same.
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_INTERVIEW_VOICE=true

# openai | groq | gemini | anthropic | mock. Unset auto-detects from the keys
# present, preferring OpenAI. NEVER leave this on `mock` outside local UI work —
# a mock-graded interview is not a real result.
INTERVIEW_LLM_PROVIDER=openai

# Optional overrides.
# OPENAI_INTERVIEW_MODEL=gpt-4o          # the judge
# OPENAI_INTERVIEW_REPORT_MODEL=gpt-4o   # the report narrative
# INTERVIEW_STT_MODEL=gpt-4o-transcribe
# INTERVIEW_TTS_MODEL=gpt-4o-mini-tts
# INTERVIEW_TTS_VOICE=ash
GROQ_API_KEY=your_groq_api_key_here