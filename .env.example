# Chatbot
ENABLE_CHATBOT=true

# Recruiter email OTP login/register. Unset (default) keeps them closed.
# ENABLE_RECRUITER_AUTH=true

# W1-A Points write authority. Unset/false keeps User.synergyPoints authoritative.
# Do not enable until Points recon is clean. Dual-write stays on either way.
# ENABLE_NEW_POINTS_WRITES=true

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth / application secret
AUTH_SECRET=your_auth_secret_here