# Chatbot
ENABLE_CHATBOT=true

# Virtual candidates: an empty search offers to source the requirement.
# Needs the VirtualCandidate tables. Apply the migration with
#   prisma db execute --file prisma/migrations/20260826120000_virtual_candidates/migration.sql
#   prisma migrate resolve --applied 20260826120000_virtual_candidates
# (`prisma migrate deploy` cannot be used on this database — see
#  docs/project-context.md on the leftover 20260813000000_general_interview.)
# HIRE_VIRTUAL_CANDIDATES=true

# Recruiter email OTP login/register. Unset (default) keeps them closed.
# ENABLE_RECRUITER_AUTH=true

# Databricks cohort at /program/databricks. Unset/false 404s the route and
# hides the Prep Kit card. Set to true in Vercel to launch.
# ENABLE_DATABRICKS=true

# W1-A Points write authority. Unset/false keeps User.synergyPoints authoritative.
# Do not enable until Points recon is clean. Dual-write stays on either way.
# ENABLE_NEW_POINTS_WRITES=true

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth / application secret
AUTH_SECRET=your_auth_secret_here

# ------------------------------------------------------------ voice interview
# One key covers all three legs: speech-to-text, text-to-speech, and the model
# that reads the answers. Without it the interview falls back to the mock judge,
# which scores every candidate the same.
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_INTERVIEW_VOICE=true

# openai | groq | gemini | anthropic | mock. Unset auto-detects from the keys
# present, preferring OpenAI. NEVER leave this on `mock` outside local UI work —
# a mock-graded interview is not a real result.
INTERVIEW_LLM_PROVIDER=openai

# Optional overrides.
# OPENAI_INTERVIEW_MODEL=gpt-4o          # the judge
# OPENAI_INTERVIEW_REPORT_MODEL=gpt-4o   # the report narrative
# INTERVIEW_STT_MODEL=gpt-4o-transcribe
# INTERVIEW_TTS_MODEL=gpt-4o-mini-tts
# INTERVIEW_TTS_VOICE=ash
GROQ_API_KEY=your_groq_api_key_here
# ---------------------------------------------------------------------------
# Help Assistant chatbot (src/app/api/chat)
# ---------------------------------------------------------------------------
# All four provider keys above are SERVER-side only — never NEXT_PUBLIC_*.
#
# Generation runs OpenAI -> Gemini -> Groq -> Anthropic, stopping at the first
# that answers. OpenAI leads because it is the only rung on a paid plan; the
# other three are free tiers and are there for resilience.
#
# OPENAI_API_KEY now does DOUBLE DUTY: primary generation AND the retrieval
# embeddings. Removing it drops generation to Gemini and degrades retrieval to
# lexical-only — the chatbot keeps working, less well, in both respects.
#
# Cost, measured: about $0.002 per answered message on gpt-4.1-mini
# (~4.6k context tokens in, ~200 out), so roughly 450 messages per $1. Query
# embeddings are a rounding error on top. NOTE that this key is shared with the
# AI Cohort voice interview (INTERVIEW_LLM_PROVIDER), which is far more
# expensive per use — check that budget before assuming headroom here.
#
# Model overrides (all optional, defaults shown):
# CHATBOT_OPENAI_MODEL=gpt-4.1-mini
# CHATBOT_GEMINI_MODEL=gemini-flash-latest
# CHATBOT_GROQ_MODEL=openai/gpt-oss-120b
# CHATBOT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#
# Verify provider health, models, latency and failover at any time:
#   npm run check:chatbot
#
# Logs each retrieval's verdict and confidence. Local debugging only.
# CHATBOT_DEBUG=false
#
# Refreshing knowledge:
#   npm run ingest:site   # crawl public routes -> knowledge/generated (dev server must be running)
#   npm run kb:embed      # embed changed chunks -> knowledge/embeddings.json (costs OpenAI credit)
#   npm run test:chatbot  # retrieval regression suite (no API keys needed)

# Transactional mail — Brevo. Without this, sendEmail skips silently:
# recruiter sign-in codes, hire alerts, the contact form and DSAR notices
# all go nowhere. In development the recruiter code is printed to the log
# instead (see features/recruiter-auth/otp.ts).
BREVO_API_KEY=
FROM_EMAIL=team@abtalks.in
# FROM_NAME=ABTalks
# REPLY_TO_EMAIL=team@abtalks.in
